.DS_Store

# Xcode user-specific data and build products
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
ios/build-*/
ios/DerivedData/

# Nix build results
/result
/result-*

# Local server binaries
/server/nixos-control
/server/server

# Rust build output
/server/target/

# Theme selected through the control app (generated at runtime)
/desktop/selected.nix

# Archived Go binaries
/archive/server-go/nixos-control
/archive/server-go/server

# Website dependencies and build output
website/node_modules/
website/.docusaurus/
website/build/
website/.cache-loader/

# Windows image build workspace and output
windows/work/
windows/out/

# Image Studio runtime data, uploads, build artifacts and bundles
image-studio/var/
image-studio/node_modules/

# Third-party Windows theme downloads (not redistributed)
windows/themes/downloads/*
!windows/themes/downloads/.gitkeep

# Third-party Windows app installers (fetched locally, not committed)
scripts/windows/apps/

# Python bytecode from the unattend renderer
__pycache__/
*.pyc
