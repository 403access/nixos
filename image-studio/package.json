{
  "name": "image-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server and web UI for building, trimming and exporting NixOS and Windows images",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "image-studio": "./bin/image-studio.js",
    "image-studio-mcp": "./src/mcp.js"
  },
  "scripts": {
    "start": "node src/web.js",
    "mcp": "node src/mcp.js",
    "doctor": "node bin/image-studio.js doctor",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "check": "npm run check:util && npm run check:config && npm run check:runner && npm run check:profiles && npm run check:jobs && npm run check:offline && npm run check:live && npm run check:images && npm run check:bundle && npm run check:mcp && npm run check:web && npm run check:cli && npm run check:bin",
    "check:util": "node --check src/util.js",
    "check:config": "node --check src/config.js",
    "check:runner": "node --check src/runner.js",
    "check:profiles": "node --check src/profiles.js",
    "check:jobs": "node --check src/jobs.js",
    "check:offline": "node --check src/offline.js",
    "check:live": "node --check src/live.js",
    "check:images": "node --check src/images.js",
    "check:bundle": "node --check src/bundle.js",
    "check:mcp": "node --check src/mcp.js",
    "check:web": "node --check src/web.js",
    "check:cli": "node --check src/cli.js",
    "check:bin": "node --check bin/image-studio.js"
  }
}
